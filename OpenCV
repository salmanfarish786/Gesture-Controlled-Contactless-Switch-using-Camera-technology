# Main_AllInOne_WS_toggle.py
# OpenCV + MediaPipe finger detection -> WebSocket to ESP32 (toggle on rising edge)
# Requirements:
#   pip install opencv-python mediapipe websocket-client

import cv2
import mediapipe as mp
import time
import threading
from collections import deque
from websocket import WebSocketApp

# ------------- CONFIG -------------
ESP_WS_URL = "ws://10.99.63.207:81"   # <-- change to your ESP IP
DEBOUNCE_FRAMES = 5                   # increase for more stability
CAM_W, CAM_H = 640, 480
PROCESS_W, PROCESS_H = 320, 240
REQUEST_FPS = 60
DRAW_LANDMARKS = True
# -----------------------------------

class ESPWebSocket:
    def __init__(self, url: str):
        self.url = url
        self.ws = None
        self.connected = threading.Event()
        self.lock = threading.Lock()
        self.thread = None
        self._stop = threading.Event()
        self._latest_state = None

    def start(self):
        self.thread = threading.Thread(target=self._run, daemon=True)
        self.thread.start()

    def stop(self):
        self._stop.set()
        try:
            if self.ws:
                self.ws.close()
        except:
            pass
        self.connected.clear()

    def send(self, text: str):
        self._latest_state = text
        if not self.connected.is_set():
            return False
        try:
            with self.lock:
                self.ws.send(text)
            return True
        except Exception as e:
            print("[WS] send failed:", e)
            self.connected.clear()
            return False

    def _on_open(self, _ws):
        print("[WS] Connected")
        self.connected.set()
        if self._latest_state:
            try:
                with self.lock:
                    self.ws.send(self._latest_state)
                print("[WS] Resync sent:", self._latest_state)
            except Exception as e:
                print("[WS] resync failed:", e)

    def _on_close(self, _ws, code, msg):
        print(f"[WS] Disconnected ({code}): {msg}")
        self.connected.clear()

    def _on_error(self, _ws, err):
        print("[WS] Error:", err)
        self.connected.clear()

    def _on_message(self, _ws, message):
        pass

    def _run(self):
        backoff = 0.5
        while not self._stop.is_set():
            try:
                self.ws = WebSocketApp(
                    self.url,
                    on_open=self._on_open,
                    on_message=self._on_message,
                    on_error=self._on_error,
                    on_close=self._on_close,
                )
                self.ws.run_forever(ping_interval=10, ping_timeout=5)
            except Exception as e:
                print("[WS] run_forever exception:", e)
                self.connected.clear()

            if self._stop.is_set():
                break

            time.sleep(backoff)
            backoff = min(backoff * 2, 5.0)

# ---- MediaPipe setup ----
mp_hands = mp.solutions.hands
hands = mp_hands.Hands(
    static_image_mode=False,
    max_num_hands=1,
    min_detection_confidence=0.6,
    min_tracking_confidence=0.6
)
mp_draw = mp.solutions.drawing_utils

# ---- Camera setup ----
cap = cv2.VideoCapture(0)
cap.set(cv2.CAP_PROP_FRAME_WIDTH, CAM_W)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, CAM_H)
cap.set(cv2.CAP_PROP_FPS, REQUEST_FPS)
cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)

# ---- Debounce buffer ----
buffer = deque(maxlen=DEBOUNCE_FRAMES)
last_sent = None            # last stable tuple we used for debounce comparison
prev_visible = (0,0,0,0)    # previous stable visible state for edge detection

# ---- Start WebSocket ----
esp = ESPWebSocket(ESP_WS_URL)
esp.start()

def tuple_to_toggle_str(t):
    # 4 chars: Index, Middle, Ring, Pinky ('1' => toggle this channel, '0' => no action)
    return ''.join('1' if v else '0' for v in t)

def detect_fingers(hand_landmarks):
    def up(tip_idx, pip_idx):
        try:
            return 1 if hand_landmarks.landmark[tip_idx].y < hand_landmarks.landmark[pip_idx].y else 0
        except:
            return 0
    idx = up(8, 6)
    mid = up(12, 10)
    ring = up(16, 14)
    pinky = up(20, 18)
    return (idx, mid, ring, pinky)

try:
    prev_time = 0.0
    while True:
        ok, frame = cap.read()
        if not ok:
            print("Camera read failed")
            break

        frame = cv2.flip(frame, 1)
        small = cv2.resize(frame, (PROCESS_W, PROCESS_H))
        img_rgb = cv2.cvtColor(small, cv2.COLOR_BGR2RGB)
        results = hands.process(img_rgb)

        finger_states = (0,0,0,0)
        if results.multi_hand_landmarks:
            hl = results.multi_hand_landmarks[0]
            if DRAW_LANDMARKS:
                mp_draw.draw_landmarks(frame, hl, mp_hands.HAND_CONNECTIONS)
            finger_states = detect_fingers(hl)

        # Debounce buffer
        buffer.append(finger_states)
        stable = None
        if len(buffer) == DEBOUNCE_FRAMES and len(set(buffer)) == 1:
            stable = buffer[-1]

        # If stable detected, compute rising edges (0->1) relative to prev_visible
        if stable is not None:
            # compute rising edges: toggle when stable has 1 and prev_visible was 0
            toggles = tuple(1 if stable[i] == 1 and prev_visible[i] == 0 else 0 for i in range(4))
            # if any toggles present, send toggle command
            if any(toggles):
                state_str = tuple_to_toggle_str(toggles)
                sent = esp.send(state_str)
                if sent:
                    print("[WS] Sent toggle:", state_str)
                else:
                    print("[WS] Not connected, toggle cached:", state_str)
            # update prev_visible to current stable (so removal will not generate toggles)
            prev_visible = stable

        # If no hand detected for a while we may want to reset prev_visible to zeros
        # but keep persistent relay states on ESP. We purposely DO NOT send off when hand removed.
        if not results.multi_hand_landmarks:
            # keep prev_visible as-is or optionally set to (0,0,0,0) to allow re-show detection.
            # It's better to set prev_visible to zeros once hand disappears so that next show triggers toggles.
            prev_visible = (0,0,0,0)

        # FPS & status display
        now = time.time()
        fps = 1.0 / (now - prev_time) if prev_time else 0.0
        prev_time = now

        status = f"I:{finger_states[0]} M:{finger_states[1]} R:{finger_states[2]} P:{finger_states[3]}"
        cv2.putText(frame, status, (10, 60), cv2.FONT_HERSHEY_SIMPLEX, 0.9, (0,255,0), 2)
        cv2.putText(frame, f"FPS: {int(fps)}", (10, 100), cv2.FONT_HERSHEY_SIMPLEX, 0.9, (255,0,0), 2)

        cv2.imshow("Hand -> ESP (WebSocket Toggle Mode)", frame)
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

finally:
    cap.release()
    cv2.destroyAllWindows()
    esp.stop()
